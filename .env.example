# ── Core ──────────────────────────────────────────────────────────────────
NODE_ENV=production
# PORT is injected by Railway — do NOT set it there. Locally it defaults to 8090.
# PORT=8090
TRUST_PROXY=true
CORS_ORIGIN=*
# silent | error (default) | all  — keep quiet on Railway to avoid log cost/crash
LOG_LEVEL=error

# ── Supabase Postgres (Session pooler URI; SSL is enabled automatically) ─────
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# ── OTP session (in-memory) ──────────────────────────────────────────────────
SESSION_TTL_MINUTES=10

# ── Fayda Server 3 (eSignet) — must match the working downloader config ──────
FAYDA_API_BASE=https://fayda-app-backend.fayda.et
ESIGNET_BASE=https://auth.fayda.et
FAYDA_API_KEY=
SERVER_THREE_OTP_CHANNELS=email,phone
# server3AuthFlow reads THIS timeout var (not UPSTREAM_*). 180s like the bot.
FAYDA_REQUEST_TIMEOUT_MS=180000
SERVER_THREE_BACKEND_USE_API_KEY=never
SERVER_THREE_BACKEND_MINIMAL_HEADERS=true

# ── Fayda Server 5 (resident portal, api-resident.fayda.et) ──────────────────
# Reuses the Server-3 eSignet exchange, then pulls the full identity record and
# draws the card + QR locally. 16-digit FAN only. REQUIRED to enable: the Basic
# credential (base64 of "resident:<secret>", or the raw "resident:<secret>").
# Can also be set at runtime from the bot with /residentbasic (falls back here).
RESIDENT_BASIC_AUTH=
# Defaults below are correct for the live resident portal — override only if it moves.
# RESIDENT_API_BASE=https://api-resident.fayda.et
# RESIDENT_CLIENT_ID=ajcCvwQcVm1dAr6HaW4Y5ObnDmwPPTpH9oDaZSPPrpo
# RESIDENT_REDIRECT_URI=https://resident.fayda.et/callback
# RESIDENT_OTP_CHANNELS=PHONE
# RESIDENT_TIMEOUT_S=45
# The generated QR cannot verify; this picks HOW it fails. Change at runtime with
# the bot's /qrmode. data | nosig | blank | unscannable  (default: data)
# SERVER5_QR_GEN_DEFAULT=data

# ── Telegram management bot (admin: approve users, keys, limits, billing) ─────
ENABLE_TELEGRAM_BOT=true
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_IDS=1730215473

# ── Defaults / billing ───────────────────────────────────────────────────────
DEFAULT_DAILY_LIMIT=0
DEFAULT_TOTAL_LIMIT=0
TRIAL_REWARD_COUNT=15
GLOBAL_PRICE=5

# ── Server 4 App Check token auto-update (optional; sensible defaults) ─────────
# Polls the token API for the latest device token and updates Server 4 when fresher.
# The /token endpoint REQUIRES an X-CSRF-Token — get yours from the token bot's
# /csrf command and put it in SERVER4_TOKEN_API_CSRF (see API_USAGE.md).
# SERVER4_TOKEN_API_URL=http://173.249.21.62:8010/token
SERVER4_TOKEN_API_CSRF=
# SERVER4_TOKEN_POLL_MS=180000
# SERVER4_TOKEN_AUTO_UPDATE=true

# ── Optional tuning ──────────────────────────────────────────────────────────
# PG_POOL_MAX=5
